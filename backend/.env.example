# Copy to .env. Secrets marked (secret) stay on the backend and are never logged.
PORT=8787
CORS_ORIGINS=http://localhost:3000
DB_PATH=./data/ghostwriter.db

# --- generated by `pnpm keys` (secret) ---
ADMIN_TOKEN=
QUOTE_SIGNING_KEY_HEX=
RECORD_SIGNING_KEY_HEX=
MEMWAL_BORROWER_DELEGATE_KEY=

# --- Tatum (secret) ---
TATUM_API_KEY_MAINNET=
TATUM_API_KEY_TESTNET=
TATUM_RPS=3

# --- Sui Testnet deployment (backend/move/DEPLOYMENTS.md) ---
SERVER_SUI_PRIVATE_KEY=            # (secret) suiprivkey1…
GHOSTWRITER_PACKAGE_ID=0xff272f596619f255a591323d32d7d0a3835fbdaf84718bdb61f7dec263e23060
GHOSTWRITER_ADMIN_CAP_ID=0x0efa4379f064661d32d5ae86872e423be6a4b9245b2a15b07b6ef6542f6abc0e
GHOSTWRITER_POOL_ID=               # from `pnpm pool:create`
COIN_TYPE=0x6dc2c1e1afe9ceece7e2bf64c52055110e5777404d6d23c6d5e51622ec14f2f1::gusd::GUSD
COIN_DECIMALS=6
GUSD_FAUCET_ID=0x728cea2bd6f17243b575bea09e017407919113aff264389f707bd7b3529501d5
ENCLAVE_CONFIG_OBJECT_ID=0xea95563f84284e7bfef75a0885ea361c1ccaf8d70005e7e151ed0442333e57f8
ENCLAVE_OBJECT_ID=                 # P7
ENCLAVE_URL=                       # P7

# --- Walrus Memory, Mainnet ---
MEMWAL_UNDERWRITER_ACCOUNT_ID=
WALRUS_PRIVATE_KEY=                # (secret) delegate key registered on the account above
WALRUS_PUBLIC_KEY=

# --- Prices: Pyth on-chain objects on Sui Testnet (no API key needed) ---
ENABLED_ASSETS=SUI                 # BTC's testnet price object is stale
MAX_PRICE_AGE_S=180
PYTH_API_KEY=                      # optional; only needed with a paid plan

# --- LLM: Vultr inference (secret key) ---
VULTR_INFERENCE_API_KEY=
VULTR_INFERENCE_BASE_URL=
VULTR_INFERENCE_MODEL=

HEDGE_ENABLED=false
PRICE_POLL_MS=10000
LIQ_POLL_MS=20000
PUBLIC_BASE_URL=http://localhost:8787
